# Copiez ce fichier en .env puis renseignez vos valeurs.
# .env est ignoré par Git : ne jamais le committer.

# OpenSlice (passerelle TMF + Keycloak)
OPENSLICE_URL=http://openslice.local
# API catalogue TMF633 si elle est exposée sur un autre port (sinon, laisser vide = OPENSLICE_URL)
OPENSLICE_CATALOG_URL=
OPENSLICE_USERNAME=
OPENSLICE_PASSWORD=

# API de l'ontologie (GraphDB) : routes /query, /concret-cfs, /concret-rfs
ONTOLOGY_API_URL=http://localhost:8000

# Ollama (LLM et embeddings locaux)
OLLAMA_URL=http://localhost:11434

# Qdrant (base vectorielle)
QDRANT_URL=http://localhost:6333
